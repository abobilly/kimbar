# Environment Variables (copy to .env and fill in real values)

# =============================================================================
# REQUIRED FOR BASIC OPERATION
# =============================================================================

# Dev server (for Playwright smoke tests)
DEV_SERVER_URL=http://localhost:8080

# Enable Arcade Physics debug overlays in dev (VITE prefix = exposed to client)
VITE_PHYS_DEBUG=0

# =============================================================================
# QDRANT VECTOR DB (for semantic search features)
# =============================================================================

# Qdrant Cloud (free tier available)
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# Collections (versioned with vector size suffix)
QDRANT_REPO_COLLECTION=kimbar_repo_v1_3072
QDRANT_FLASHCARDS_COLLECTION=kimbar_flashcards_v1_3072

# =============================================================================
# OPENAI (for embeddings)
# =============================================================================

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMS=3072

# =============================================================================
# CLOUDFLARE (for production deployment)
# =============================================================================

CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
CF_S3_API=https://your-account-id.r2.cloudflarestorage.com

# Flashcard API (Cloudflare Worker)
FLASHCARD_API_URL=https://flashcard-api.your-subdomain.workers.dev/flashcards
VITE_FLASHCARD_API_URL=https://flashcard-api.your-subdomain.workers.dev/flashcards

# GFX R2 bucket (for AI-generated sprites)
GFX_BASE_URL=https://gfx.your-domain.com
GFX_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
GFX_R2_BUCKET=your-gfx-bucket
GFX_R2_PREFIX=polished/
GFX_R2_REGION=auto
GFX_R2_ACCESS_KEY_ID=your-r2-access-key-id
GFX_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# =============================================================================
# HUGGING FACE (for AI model access)
# =============================================================================

HF_TOKEN=hf_your-huggingface-token

# =============================================================================
# INDEX SCOPE (for repo indexing scripts)
# =============================================================================

REPO_INDEX_SCOPE=src,docs,public/content,schemas,scripts
REPO_CHUNK_LINES=150
REPO_CHUNK_OVERLAP=20
