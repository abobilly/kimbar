{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "RoomEntry.schema.json",
  "title": "RoomEntry",
  "description": "Registry entry for a room/level. Use levelUrl (Tiled-compiled) OR ldtkUrl (legacy LDtk).",
  "type": "object",
  "required": [
    "id"
  ],
  "anyOf": [
    {
      "required": [
        "ldtkUrl"
      ]
    },
    {
      "required": [
        "levelUrl"
      ]
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "description": "Unique room identifier"
    },
    "ldtkUrl": {
      "type": "string",
      "pattern": "^/content/ldtk/",
      "description": "URL path to the LDtk JSON file (legacy bridge)"
    },
    "levelUrl": {
      "type": "string",
      "pattern": "^/generated/levels/",
      "description": "URL path to compiled Tiled LevelData JSON (preferred)"
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable room name"
    },
    "environment": {
      "type": "string",
      "enum": [
        "interior",
        "exterior"
      ],
      "description": "Whether the room is interior or exterior (affects lighting, weather)"
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Named spawn points in this room"
    },
    "$schema": {
      "type": "string",
      "description": "JSON schema reference (ignored at runtime)"
    }
  },
  "additionalProperties": false
}