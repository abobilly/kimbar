{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "WorldGraph.schema.json",
    "title": "WorldGraph",
    "description": "Canonical world topology: nodes (rooms) and edges (doors/transitions)",
    "type": "object",
    "required": [
        "version",
        "nodes",
        "edges"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON schema reference (ignored at runtime)"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version of the world graph"
        },
        "tileSize": {
            "type": "number",
            "minimum": 1,
            "description": "Tile size in pixels (used for portal bounds when coordinates are in tiles)"
        },
        "nodes": {
            "type": "array",
            "description": "List of rooms/areas in the world",
            "items": {
                "$ref": "#/definitions/WorldNode"
            }
        },
        "edges": {
            "type": "array",
            "description": "List of connections (doors/transitions) between rooms",
            "items": {
                "$ref": "#/definitions/WorldEdge"
            }
        }
    },
    "additionalProperties": false,
    "definitions": {
        "WorldNode": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_]*$",
                    "description": "Unique room identifier (must match RoomEntry.id)"
                },
                "displayName": {
                    "type": "string",
                    "description": "Human-readable room name"
                },
                "region": {
                    "type": "string",
                    "description": "Logical region grouping (e.g., 'supreme-court')"
                },
                "spawns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Named spawn points in this room"
                },
                "bounds": {
                    "$ref": "#/definitions/WorldBounds"
                },
                "portals": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/WorldPortal"
                    },
                    "description": "Door/exit portals within this room"
                }
            },
            "additionalProperties": false
        },
        "WorldBounds": {
            "type": "object",
            "required": [
                "width",
                "height"
            ],
            "properties": {
                "width": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Room width in tiles"
                },
                "height": {
                    "type": "number",
                    "minimum": 1,
                    "description": "Room height in tiles"
                }
            },
            "additionalProperties": false
        },
        "WorldPortal": {
            "type": "object",
            "required": [
                "id",
                "x",
                "y"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_]*$",
                    "description": "Portal identifier (unique within room)"
                },
                "x": {
                    "type": "number",
                    "description": "Portal X coordinate (tiles)"
                },
                "y": {
                    "type": "number",
                    "description": "Portal Y coordinate (tiles)"
                },
                "width": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Portal width (tiles)"
                },
                "height": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Portal height (tiles)"
                },
                "facing": {
                    "type": "string",
                    "enum": [
                        "up",
                        "down",
                        "left",
                        "right"
                    ],
                    "description": "Direction the portal faces"
                },
                "notes": {
                    "type": "string",
                    "description": "Human-readable notes about this portal"
                }
            },
            "additionalProperties": false
        },
        "WorldEdge": {
            "type": "object",
            "required": [
                "doorId",
                "fromRoomId",
                "toRoomId",
                "toSpawnTag"
            ],
            "properties": {
                "doorId": {
                    "type": "string",
                    "description": "Stable, unique identifier for this door/transition"
                },
                "fromRoomId": {
                    "type": "string",
                    "description": "Room containing the door (must match a node id)"
                },
                "toRoomId": {
                    "type": "string",
                    "description": "Destination room (must match a node id)"
                },
                "toSpawnTag": {
                    "type": "string",
                    "description": "Spawn point in the destination room"
                },
                "facing": {
                    "type": "string",
                    "enum": [
                        "up",
                        "down",
                        "left",
                        "right"
                    ],
                    "description": "Direction the door faces (for visual/collision)"
                },
                "locked": {
                    "type": "boolean",
                    "description": "Whether the door is locked by default"
                },
                "requires": {
                    "type": "string",
                    "description": "Key or condition required to unlock"
                },
                "oneWay": {
                    "type": "boolean",
                    "description": "If true, cannot traverse in reverse direction"
                },
                "notes": {
                    "type": "string",
                    "description": "Human-readable notes about this transition"
                }
            },
            "additionalProperties": false
        }
    }
}