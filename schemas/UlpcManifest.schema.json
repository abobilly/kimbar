{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "UlpcManifest.schema.json",
    "title": "UlpcManifest",
    "type": "object",
    "required": [
        "files",
        "globs"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "notes": {
            "type": "string"
        },
        "files": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "globs": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": false
}